{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:staruw:1.0:model-catalog",
  "type": "object",
  "properties": {
    "format": {
      "const": "com.realize.starmark.model-catalog"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "make": {
            "type": "string",
            "maxLength": 128
          },
          "size": {
            "$ref": "#/$defs/positivePoint"
          },
          "baseline": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resourceId": {
                  "$ref": "#/$defs/id"
                },
                "x": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "resourceId",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "model",
          "size",
          "baseline",
          "components"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "format",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "positivePoint": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000000
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
